{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "bun-graph-db-node",
  "main": "worker.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "GRAPH_NODE",
        "class_name": "GraphNodeDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GraphNodeDurableObject"]
    }
  ],
  "vars": {
    "DEFAULT_NODE_KEY": "default",
    "GRAPH_NODE_HEADER": "x-graph-node-id"
  }
}
