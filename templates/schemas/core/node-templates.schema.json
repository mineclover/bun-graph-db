{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bun-graph-db.com/schemas/node-templates.schema.json",
  "title": "Node Template Schema",
  "description": "JSON Schema for node-related GraphQL query templates",
  "type": "object",
  "required": ["identifier", "name", "queryText", "templateType"],
  "properties": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "minLength": 3,
      "maxLength": 100,
      "description": "Unique identifier for the template"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Human-readable name for the template"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Detailed description of what the template does"
    },
    "queryText": {
      "type": "string",
      "minLength": 10,
      "description": "GraphQL query or mutation text with variable placeholders"
    },
    "templateType": {
      "type": "string",
      "enum": ["query", "mutation"],
      "description": "Type of GraphQL operation"
    },
    "variablesSchema": {
      "type": "object",
      "description": "JSON Schema defining the structure of variables",
      "properties": {
        "type": { "const": "object" },
        "properties": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": ["string", "integer", "number", "boolean", "array", "object"]
                },
                "description": { "type": "string" },
                "default": {},
                "enum": { "type": "array" },
                "minimum": { "type": "number" },
                "maximum": { "type": "number" },
                "minLength": { "type": "integer" },
                "maxLength": { "type": "integer" },
                "pattern": { "type": "string" }
              },
              "required": ["type"]
            }
          }
        },
        "required": { "type": "array", "items": { "type": "string" } }
      }
    },
    "defaultVariables": {
      "type": "object",
      "description": "Default values for template variables"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      },
      "uniqueItems": true,
      "description": "Tags for categorizing and searching templates"
    },
    "nodeOperations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "create", "read", "update", "delete",
          "search", "list", "count", "exists",
          "setAttribute", "getAttribute", "removeAttribute"
        ]
      },
      "description": "Node operations this template supports"
    },
    "supportedTables": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Table identifiers this template works with (empty = all tables)"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version of the template"
        },
        "author": {
          "type": "string",
          "description": "Template author"
        },
        "lastModified": {
          "type": "string",
          "format": "date-time",
          "description": "Last modification timestamp"
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Other templates this template depends on"
        },
        "complexity": {
          "type": "string",
          "enum": ["simple", "medium", "complex"],
          "description": "Complexity level of the template"
        },
        "performance": {
          "type": "object",
          "properties": {
            "estimatedResponseTime": { "type": "string" },
            "memoryUsage": { "type": "string" },
            "cacheStrategy": { 
              "type": "string",
              "enum": ["none", "short", "medium", "long"]
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "requiresAuthentication": {
          "type": "boolean",
          "default": false,
          "description": "Whether this template requires user authentication"
        },
        "dangerousOperations": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["delete", "bulk-update", "cascade-delete"]
          },
          "description": "Dangerous operations this template performs"
        },
        "inputSanitization": {
          "type": "boolean",
          "default": true,
          "description": "Whether input variables should be sanitized"
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "variables": { "type": "object" },
          "expectedResult": { "type": "object" }
        },
        "required": ["name", "variables"]
      },
      "description": "Usage examples for the template"
    }
  },
  "additionalProperties": false
}