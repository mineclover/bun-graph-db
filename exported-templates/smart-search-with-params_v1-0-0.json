    "identifier": "smart-search-with-params",
    "name": "SmartSearchWithParams",
    "description": "파라미터를 사용하여 지능형 검색을 수행합니다",
    "query": "query SmartSearchWithParams($query: String!, $context: SearchContext, $options: SmartSearchOptions) {\n  smartSearch(query: $query, context: $context, options: $options) {\n    results {\n      nodes {\n        id\n        title\n        content\n        relevanceScore\n        matchedFields\n        highlights\n        relationships {\n          id\n          title\n          relationshipType\n          strength\n        }\n      }\n      tables {\n        id\n        identifier\n        description\n        relevanceScore\n        matchReason\n      }\n      templates {\n        id\n        identifier\n        name\n        relevanceScore\n        suggestedVariables\n      }\n    }\n    suggestions {\n      queryCorrections\n      semanticExpansions\n      relatedTerms\n      filters\n    }\n    analytics {\n      searchTime\n      indexesUsed\n      cacheHit\n      resultsCount\n    }\n    recommendations {\n      type\n      items\n      confidence\n      reasoning\n    }\n  }\n}",
    "queryName": [
      "smartSearch"
    ],
    "operationType": "query",
