{
  "id": "graph-relationship-test-suite",
  "name": "Graph Relationship Test Suite",
  "description": "Comprehensive test suite for graph relationships and traversal",
  "version": "1.0.0",
  "metadata": {
    "created": "2025-01-05",
    "author": "test-automation",
    "tags": ["graph", "relationships", "traversal", "integration-test"]
  },
  "templates": [
    {
      "identifier": "test-create-relation",
      "name": "Create Relation",
      "description": "Create a relationship between two nodes",
      "templateType": "MUTATION",
      "queryText": "mutation CreateRelation($input: CreateRelationInput!) {\n  createRelation(input: $input) {\n    success\n    data {\n      id\n      sourceNodeId\n      targetNodeId\n      relationTypeId\n      properties\n      strength\n      confidence\n      createdAt\n    }\n    errors {\n      code\n      message\n    }\n  }\n}",
      "variablesSchema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "object",
            "properties": {
              "tableId": { "type": "string" },
              "sourceNodeId": { "type": "string" },
              "targetNodeId": { "type": "string" },
              "relationTypeId": { "type": "string" },
              "properties": { "type": "object" },
              "strength": { "type": "number", "minimum": 0, "maximum": 10 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["tableId", "sourceNodeId", "targetNodeId", "relationTypeId"]
          }
        },
        "required": ["input"]
      },
      "tags": ["create", "relation", "mutation"],
      "complexityScore": 3
    },
    {
      "identifier": "test-get-node-relations",
      "name": "Get Node Relations",
      "description": "Get all relations for a specific node",
      "templateType": "QUERY",
      "queryText": "query GetNodeRelations($nodeId: ID!, $direction: RelationDirection) {\n  node(id: $nodeId) {\n    id\n    content\n    relations(direction: $direction) {\n      totalCount\n      edges {\n        id\n        relationType {\n          identifier\n          name\n        }\n        targetNode {\n          id\n          content\n          title\n        }\n        sourceNode {\n          id\n          content\n          title\n        }\n        properties\n        strength\n        confidence\n      }\n    }\n  }\n}",
      "variablesSchema": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "description": "Node ID to get relations for"
          },
          "direction": {
            "type": "string",
            "enum": ["INCOMING", "OUTGOING", "BOTH"],
            "description": "Direction of relations to retrieve"
          }
        },
        "required": ["nodeId"]
      },
      "tags": ["read", "relation", "query", "traversal"],
      "complexityScore": 4
    },
    {
      "identifier": "test-traverse-graph",
      "name": "Traverse Graph",
      "description": "Traverse graph with depth and filters",
      "templateType": "QUERY",
      "queryText": "query TraverseGraph($startNodeId: ID!, $depth: Int!, $relationTypes: [ID!]) {\n  traverseGraph(startNodeId: $startNodeId, depth: $depth, relationTypes: $relationTypes) {\n    nodes {\n      id\n      content\n      title\n      depth\n      path\n    }\n    edges {\n      sourceId\n      targetId\n      relationTypeId\n      strength\n    }\n    statistics {\n      totalNodes\n      totalEdges\n      maxDepth\n      averageStrength\n    }\n  }\n}",
      "variablesSchema": {
        "type": "object",
        "properties": {
          "startNodeId": {
            "type": "string",
            "description": "Starting node for traversal"
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "Maximum traversal depth"
          },
          "relationTypes": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Filter by relation type IDs"
          }
        },
        "required": ["startNodeId", "depth"]
      },
      "tags": ["traversal", "graph", "query", "analytics"],
      "complexityScore": 8
    },
    {
      "identifier": "test-find-shortest-path",
      "name": "Find Shortest Path",
      "description": "Find shortest path between two nodes",
      "templateType": "QUERY",
      "queryText": "query FindShortestPath($sourceNodeId: ID!, $targetNodeId: ID!, $maxDepth: Int) {\n  shortestPath(sourceNodeId: $sourceNodeId, targetNodeId: $targetNodeId, maxDepth: $maxDepth) {\n    found\n    distance\n    path {\n      nodeId\n      content\n      title\n    }\n    edges {\n      sourceId\n      targetId\n      relationTypeId\n      strength\n    }\n  }\n}",
      "variablesSchema": {
        "type": "object",
        "properties": {
          "sourceNodeId": {
            "type": "string",
            "description": "Starting node ID"
          },
          "targetNodeId": {
            "type": "string",
            "description": "Target node ID"
          },
          "maxDepth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10,
            "description": "Maximum search depth"
          }
        },
        "required": ["sourceNodeId", "targetNodeId"]
      },
      "tags": ["pathfinding", "graph", "query", "analytics"],
      "complexityScore": 9
    },
    {
      "identifier": "test-update-relation",
      "name": "Update Relation",
      "description": "Update relation properties and strength",
      "templateType": "MUTATION",
      "queryText": "mutation UpdateRelation($relationId: ID!, $input: UpdateRelationInput!) {\n  updateRelation(id: $relationId, input: $input) {\n    success\n    data {\n      id\n      properties\n      strength\n      confidence\n      updatedAt\n    }\n    errors {\n      code\n      message\n    }\n  }\n}",
      "variablesSchema": {
        "type": "object",
        "properties": {
          "relationId": {
            "type": "string",
            "description": "Relation ID to update"
          },
          "input": {
            "type": "object",
            "properties": {
              "properties": { "type": "object" },
              "strength": { "type": "number", "minimum": 0, "maximum": 10 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "required": ["relationId", "input"]
      },
      "tags": ["update", "relation", "mutation"],
      "complexityScore": 2
    },
    {
      "identifier": "test-delete-relation",
      "name": "Delete Relation",
      "description": "Delete a relationship",
      "templateType": "MUTATION",
      "queryText": "mutation DeleteRelation($relationId: ID!) {\n  deleteRelation(id: $relationId) {\n    success\n    message\n    errors {\n      code\n      message\n    }\n  }\n}",
      "variablesSchema": {
        "type": "object",
        "properties": {
          "relationId": {
            "type": "string",
            "description": "Relation ID to delete"
          }
        },
        "required": ["relationId"]
      },
      "tags": ["delete", "relation", "mutation"],
      "complexityScore": 2
    },
    {
      "identifier": "test-analyze-cluster",
      "name": "Analyze Node Cluster",
      "description": "Analyze connectivity and clustering around a node",
      "templateType": "QUERY",
      "queryText": "query AnalyzeCluster($nodeId: ID!, $radius: Int!) {\n  analyzeCluster(nodeId: $nodeId, radius: $radius) {\n    clusterSize\n    density\n    averageStrength\n    centralNodes {\n      id\n      content\n      centrality\n    }\n    communities {\n      id\n      size\n      cohesion\n      nodes {\n        id\n        content\n      }\n    }\n  }\n}",
      "variablesSchema": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "description": "Center node for cluster analysis"
          },
          "radius": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 2,
            "description": "Analysis radius"
          }
        },
        "required": ["nodeId", "radius"]
      },
      "tags": ["analytics", "cluster", "graph", "query"],
      "complexityScore": 10
    }
  ],
  "datasets": [
    {
      "id": "social-network-graph",
      "name": "Social Network Graph Test",
      "description": "Test social network relationships and traversal",
      "setup": {
        "nodes": [
          { "id": "user1", "content": "alice@example.com", "title": "Alice" },
          { "id": "user2", "content": "bob@example.com", "title": "Bob" },
          { "id": "user3", "content": "charlie@example.com", "title": "Charlie" },
          { "id": "user4", "content": "diana@example.com", "title": "Diana" },
          { "id": "user5", "content": "eve@example.com", "title": "Eve" }
        ],
        "relationTypes": [
          { "id": "follows", "identifier": "follows", "name": "Follows" },
          { "id": "friend", "identifier": "friend_of", "name": "Friend Of" },
          { "id": "blocks", "identifier": "blocks", "name": "Blocks" }
        ]
      },
      "executions": [
        {
          "templateId": "test-create-relation",
          "variables": {
            "input": {
              "tableId": "users",
              "sourceNodeId": "${setup.nodes[0].id}",
              "targetNodeId": "${setup.nodes[1].id}",
              "relationTypeId": "${setup.relationTypes[0].id}",
              "strength": 8,
              "properties": { "since": "2024-01-01" }
            }
          },
          "order": 1,
          "description": "Alice follows Bob"
        },
        {
          "templateId": "test-create-relation",
          "variables": {
            "input": {
              "tableId": "users",
              "sourceNodeId": "${setup.nodes[1].id}",
              "targetNodeId": "${setup.nodes[0].id}",
              "relationTypeId": "${setup.relationTypes[0].id}",
              "strength": 7
            }
          },
          "order": 2,
          "description": "Bob follows Alice (mutual)"
        },
        {
          "templateId": "test-create-relation",
          "variables": {
            "input": {
              "tableId": "users",
              "sourceNodeId": "${setup.nodes[0].id}",
              "targetNodeId": "${setup.nodes[2].id}",
              "relationTypeId": "${setup.relationTypes[1].id}",
              "strength": 9,
              "confidence": 0.95
            }
          },
          "order": 3,
          "description": "Alice and Charlie are friends"
        },
        {
          "templateId": "test-create-relation",
          "variables": {
            "input": {
              "tableId": "users",
              "sourceNodeId": "${setup.nodes[2].id}",
              "targetNodeId": "${setup.nodes[3].id}",
              "relationTypeId": "${setup.relationTypes[0].id}",
              "strength": 5
            }
          },
          "order": 4,
          "description": "Charlie follows Diana"
        },
        {
          "templateId": "test-create-relation",
          "variables": {
            "input": {
              "tableId": "users",
              "sourceNodeId": "${setup.nodes[3].id}",
              "targetNodeId": "${setup.nodes[4].id}",
              "relationTypeId": "${setup.relationTypes[2].id}"
            }
          },
          "order": 5,
          "description": "Diana blocks Eve"
        },
        {
          "templateId": "test-get-node-relations",
          "variables": {
            "nodeId": "${setup.nodes[0].id}",
            "direction": "OUTGOING"
          },
          "expectedResult": {
            "relations": {
              "totalCount": 2
            }
          },
          "order": 6,
          "description": "Get Alice's outgoing relations"
        },
        {
          "templateId": "test-traverse-graph",
          "variables": {
            "startNodeId": "${setup.nodes[0].id}",
            "depth": 3
          },
          "expectedResult": {
            "statistics": {
              "totalNodes": 5,
              "maxDepth": 3
            }
          },
          "order": 7,
          "description": "Traverse from Alice with depth 3"
        },
        {
          "templateId": "test-find-shortest-path",
          "variables": {
            "sourceNodeId": "${setup.nodes[0].id}",
            "targetNodeId": "${setup.nodes[4].id}",
            "maxDepth": 5
          },
          "expectedResult": {
            "found": true,
            "distance": 4
          },
          "order": 8,
          "description": "Find path from Alice to Eve"
        },
        {
          "templateId": "test-analyze-cluster",
          "variables": {
            "nodeId": "${setup.nodes[2].id}",
            "radius": 2
          },
          "expectedResult": {
            "clusterSize": 4
          },
          "order": 9,
          "description": "Analyze cluster around Charlie"
        }
      ]
    },
    {
      "id": "knowledge-graph-test",
      "name": "Knowledge Graph Test",
      "description": "Test knowledge graph relationships and complex queries",
      "setup": {
        "nodes": [
          { "id": "concept1", "content": "Machine Learning", "title": "ML" },
          { "id": "concept2", "content": "Deep Learning", "title": "DL" },
          { "id": "concept3", "content": "Neural Networks", "title": "NN" },
          { "id": "concept4", "content": "Computer Vision", "title": "CV" },
          { "id": "concept5", "content": "Natural Language Processing", "title": "NLP" },
          { "id": "concept6", "content": "Reinforcement Learning", "title": "RL" }
        ],
        "relationTypes": [
          { "id": "subset", "identifier": "subset_of", "name": "Subset Of" },
          { "id": "related", "identifier": "related_to", "name": "Related To" },
          { "id": "prereq", "identifier": "prerequisite_for", "name": "Prerequisite For" }
        ]
      },
      "executions": [
        {
          "templateId": "test-create-relation",
          "variables": {
            "input": {
              "tableId": "concepts",
              "sourceNodeId": "${setup.nodes[1].id}",
              "targetNodeId": "${setup.nodes[0].id}",
              "relationTypeId": "${setup.relationTypes[0].id}",
              "strength": 10,
              "confidence": 1.0,
              "properties": { "taxonomy": "field_hierarchy" }
            }
          },
          "order": 1,
          "description": "Deep Learning is subset of Machine Learning"
        },
        {
          "templateId": "test-create-relation",
          "variables": {
            "input": {
              "tableId": "concepts",
              "sourceNodeId": "${setup.nodes[2].id}",
              "targetNodeId": "${setup.nodes[1].id}",
              "relationTypeId": "${setup.relationTypes[2].id}",
              "strength": 9,
              "confidence": 0.95
            }
          },
          "order": 2,
          "description": "Neural Networks prerequisite for Deep Learning"
        },
        {
          "templateId": "test-create-relation",
          "variables": {
            "input": {
              "tableId": "concepts",
              "sourceNodeId": "${setup.nodes[3].id}",
              "targetNodeId": "${setup.nodes[1].id}",
              "relationTypeId": "${setup.relationTypes[1].id}",
              "strength": 8,
              "confidence": 0.9
            }
          },
          "order": 3,
          "description": "Computer Vision related to Deep Learning"
        },
        {
          "templateId": "test-create-relation",
          "variables": {
            "input": {
              "tableId": "concepts",
              "sourceNodeId": "${setup.nodes[4].id}",
              "targetNodeId": "${setup.nodes[1].id}",
              "relationTypeId": "${setup.relationTypes[1].id}",
              "strength": 8,
              "confidence": 0.9
            }
          },
          "order": 4,
          "description": "NLP related to Deep Learning"
        },
        {
          "templateId": "test-create-relation",
          "variables": {
            "input": {
              "tableId": "concepts",
              "sourceNodeId": "${setup.nodes[5].id}",
              "targetNodeId": "${setup.nodes[0].id}",
              "relationTypeId": "${setup.relationTypes[0].id}",
              "strength": 9,
              "confidence": 0.95
            }
          },
          "order": 5,
          "description": "Reinforcement Learning subset of Machine Learning"
        },
        {
          "templateId": "test-traverse-graph",
          "variables": {
            "startNodeId": "${setup.nodes[0].id}",
            "depth": 2,
            "relationTypes": ["${setup.relationTypes[0].id}"]
          },
          "expectedResult": {
            "statistics": {
              "totalNodes": 3
            }
          },
          "order": 6,
          "description": "Find all ML subsets"
        },
        {
          "templateId": "test-find-shortest-path",
          "variables": {
            "sourceNodeId": "${setup.nodes[2].id}",
            "targetNodeId": "${setup.nodes[3].id}",
            "maxDepth": 4
          },
          "expectedResult": {
            "found": true
          },
          "order": 7,
          "description": "Path from Neural Networks to Computer Vision"
        }
      ]
    },
    {
      "id": "relation-update-delete-test",
      "name": "Relation Update and Delete Test",
      "description": "Test updating and deleting relations",
      "executions": [
        {
          "templateId": "test-create-relation",
          "variables": {
            "input": {
              "tableId": "test",
              "sourceNodeId": "${node1.id}",
              "targetNodeId": "${node2.id}",
              "relationTypeId": "${relationType.id}",
              "strength": 5,
              "properties": { "status": "initial" }
            }
          },
          "order": 1,
          "description": "Create initial relation"
        },
        {
          "templateId": "test-update-relation",
          "variables": {
            "relationId": "${execution[0].data.id}",
            "input": {
              "strength": 8,
              "confidence": 0.85,
              "properties": { "status": "updated", "timestamp": "2025-01-05" }
            }
          },
          "expectedResult": {
            "success": true,
            "data": {
              "strength": 8,
              "confidence": 0.85
            }
          },
          "order": 2,
          "description": "Update relation strength and properties",
          "dependsOn": [0]
        },
        {
          "templateId": "test-get-node-relations",
          "variables": {
            "nodeId": "${node1.id}"
          },
          "expectedResult": {
            "relations": {
              "edges": [
                {
                  "strength": 8,
                  "confidence": 0.85,
                  "properties": {
                    "status": "updated"
                  }
                }
              ]
            }
          },
          "order": 3,
          "description": "Verify updated relation"
        },
        {
          "templateId": "test-delete-relation",
          "variables": {
            "relationId": "${execution[0].data.id}"
          },
          "expectedResult": {
            "success": true
          },
          "order": 4,
          "description": "Delete the relation",
          "dependsOn": [0]
        },
        {
          "templateId": "test-get-node-relations",
          "variables": {
            "nodeId": "${node1.id}"
          },
          "expectedResult": {
            "relations": {
              "totalCount": 0
            }
          },
          "order": 5,
          "description": "Verify relation deleted"
        }
      ]
    }
  ]
}