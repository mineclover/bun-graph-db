{
  "version": "1.0",
  "description": "Base schema definition for test environment",
  "tables": [
    {
      "identifier": "products",
      "name": "Products",
      "description": "Product catalog management",
      "attributes": [
        {
          "identifier": "name",
          "name": "Product Name",
          "description": "The name of the product",
          "dataType": "STRING",
          "isRequired": true
        },
        {
          "identifier": "description",
          "name": "Product Description", 
          "description": "Detailed description of the product",
          "dataType": "TEXT",
          "isRequired": false
        },
        {
          "identifier": "price",
          "name": "Price",
          "description": "Product price in USD",
          "dataType": "DECIMAL",
          "isRequired": true
        },
        {
          "identifier": "category",
          "name": "Category",
          "description": "Product category",
          "dataType": "STRING",
          "isRequired": true
        },
        {
          "identifier": "stock",
          "name": "Stock Quantity",
          "description": "Available stock quantity",
          "dataType": "INTEGER",
          "isRequired": false
        }
      ]
    },
    {
      "identifier": "users",
      "name": "Users",
      "description": "User account management",
      "attributes": [
        {
          "identifier": "username",
          "name": "Username",
          "description": "Unique username",
          "dataType": "STRING",
          "isRequired": true
        },
        {
          "identifier": "email",
          "name": "Email",
          "description": "User email address",
          "dataType": "STRING",
          "isRequired": true
        },
        {
          "identifier": "fullName",
          "name": "Full Name",
          "description": "User's full name",
          "dataType": "STRING",
          "isRequired": false
        },
        {
          "identifier": "role",
          "name": "User Role",
          "description": "User role in the system",
          "dataType": "STRING",
          "isRequired": true
        }
      ]
    },
    {
      "identifier": "orders",
      "name": "Orders",
      "description": "Order management",
      "attributes": [
        {
          "identifier": "orderNumber",
          "name": "Order Number",
          "description": "Unique order identifier",
          "dataType": "STRING",
          "isRequired": true
        },
        {
          "identifier": "customerName",
          "name": "Customer Name",
          "description": "Name of the customer",
          "dataType": "STRING",
          "isRequired": true
        },
        {
          "identifier": "totalAmount",
          "name": "Total Amount",
          "description": "Total order amount",
          "dataType": "DECIMAL",
          "isRequired": true
        },
        {
          "identifier": "status",
          "name": "Order Status",
          "description": "Current order status",
          "dataType": "STRING",
          "isRequired": true
        }
      ]
    }
  ],
  "relationTypes": [
    {
      "identifier": "user-orders",
      "name": "User Orders",
      "description": "Relationship between users and their orders",
      "sourceTable": "users",
      "targetTable": "orders"
    },
    {
      "identifier": "order-products",
      "name": "Order Products",
      "description": "Relationship between orders and products",
      "sourceTable": "orders", 
      "targetTable": "products"
    }
  ]
}