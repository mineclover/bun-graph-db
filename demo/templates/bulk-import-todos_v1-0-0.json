{
  "identifier": "bulk-import-todos",
  "name": "BulkImportTodos",
  "description": "JSON 형태의 할일 목록을 대량으로 가져오는 템플릿",
  "query": "mutation BulkImportTodos($todos: [TodoImportInput!]!) {\n  bulkCreateNodes(\n    tableId: \"58\"\n    nodes: $todos\n  ) {\n    success\n    createdCount\n    totalCount\n    errors {\n      message\n      line\n    }\n    nodes {\n      id\n      content\n      attributes {\n        name\n        value\n      }\n    }\n  }\n}",
  "operationType": "mutation",
  "queryName": "BulkImportTodos",
  "tags": ["todo", "bulk", "import", "data"],
  "complexityScore": 5,
  "isActive": true,
  "variables": {
    "todos": [
      {
        "content": "샘플 할일 1",
        "attributes": [
          { "name": "title", "value": "샘플 할일 1" },
          { "name": "description", "value": "첫 번째 샘플 할일입니다" },
          { "name": "status", "value": "TODO" },
          { "name": "priority", "value": "HIGH" },
          { "name": "category", "value": "WORK" }
        ]
      }
    ]
  },
  "variablesSchema": {
    "todos": {
      "type": "Array",
      "required": true,
      "description": "가져올 할일 목록",
      "items": {
        "type": "Object",
        "properties": {
          "content": { "type": "String", "required": true, "description": "할일 제목" },
          "attributes": {
            "type": "Array",
            "required": true,
            "description": "할일 속성 목록",
            "items": {
              "type": "Object",
              "properties": {
                "name": { "type": "String", "required": true },
                "value": { "type": "String", "required": true }
              }
            }
          }
        }
      }
    }
  },
  "version": "1.0.0"
}