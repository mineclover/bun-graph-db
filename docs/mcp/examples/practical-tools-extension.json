{
  "title": "Practical MCP Tools Extension",
  "description": "Common and useful tools for everyday graph database operations",
  "version": "1.0.0",
  "baseUrl": "http://localhost:4000/graphql",
  "tools": [
    {
      "name": "getNodeById",
      "description": "Get a specific node by its ID",
      "category": "basic-queries",
      "complexity": "low",
      "inputSchema": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "description": "The ID of the node to retrieve"
          }
        },
        "required": ["nodeId"],
        "additionalProperties": false
      },
      "graphqlOperation": {
        "type": "query",
        "query": "query getNodeById($nodeId: String!) { node(id: $nodeId) { id content metadata createdAt updatedAt table { id identifier name } relations { id fromNodeId toNodeId relationshipType } } }"
      },
      "examples": [
        {
          "name": "Get user node",
          "description": "Retrieve a specific user node",
          "input": {
            "nodeId": "user-123"
          }
        }
      ]
    },
    {
      "name": "updateNode",
      "description": "Update a node's content and metadata",
      "category": "basic-mutations",
      "complexity": "low",
      "inputSchema": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "description": "The ID of the node to update"
          },
          "content": {
            "type": "string",
            "description": "New content for the node"
          },
          "metadata": {
            "type": "object",
            "description": "New metadata for the node",
            "additionalProperties": true
          }
        },
        "required": ["nodeId"],
        "additionalProperties": false
      },
      "graphqlOperation": {
        "type": "mutation",
        "query": "mutation updateNode($nodeId: String!, $content: String, $metadata: JSON) { updateNode(id: $nodeId, content: $content, metadata: $metadata) { success node { id content metadata updatedAt } errors { message } } }"
      },
      "examples": [
        {
          "name": "Update user profile",
          "description": "Update user's profile information",
          "input": {
            "nodeId": "user-123",
            "content": "Updated user profile",
            "metadata": {
              "email": "user@example.com",
              "status": "active"
            }
          }
        }
      ]
    },
    {
      "name": "deleteNode",
      "description": "Delete a node and optionally its relations",
      "category": "basic-mutations",
      "complexity": "medium",
      "inputSchema": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "description": "The ID of the node to delete"
          },
          "deleteRelations": {
            "type": "boolean",
            "description": "Whether to delete associated relations",
            "default": true
          }
        },
        "required": ["nodeId"],
        "additionalProperties": false
      },
      "graphqlOperation": {
        "type": "mutation",
        "query": "mutation deleteNode($nodeId: String!, $deleteRelations: Boolean) { deleteNode(id: $nodeId, deleteRelations: $deleteRelations) { success deletedNodeId deletedRelationsCount errors { message } } }"
      },
      "examples": [
        {
          "name": "Delete node with relations",
          "description": "Delete a node and all its relations",
          "input": {
            "nodeId": "temp-node-456",
            "deleteRelations": true
          }
        }
      ]
    },
    {
      "name": "findNodesByContent",
      "description": "Search for nodes by content text",
      "category": "search",
      "complexity": "low",
      "inputSchema": {
        "type": "object",
        "properties": {
          "searchText": {
            "type": "string",
            "description": "Text to search for in node content",
            "minLength": 1
          },
          "tableId": {
            "type": "string",
            "description": "Optional table ID to limit search scope"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum number of results",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        },
        "required": ["searchText"],
        "additionalProperties": false
      },
      "graphqlOperation": {
        "type": "query",
        "query": "query findNodesByContent($searchText: String!, $tableId: String, $limit: Int) { searchNodes(searchTerm: $searchText, tableId: $tableId, limit: $limit) { nodes { id content metadata createdAt table { identifier name } } totalCount } }"
      },
      "examples": [
        {
          "name": "Search for users",
          "description": "Find nodes containing 'john'",
          "input": {
            "searchText": "john",
            "limit": 10
          }
        }
      ]
    },
    {
      "name": "getTableStats",
      "description": "Get basic statistics for a table",
      "category": "utilities",
      "complexity": "low",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tableId": {
            "type": "string",
            "description": "The ID of the table to get stats for"
          }
        },
        "required": ["tableId"],
        "additionalProperties": false
      },
      "graphqlOperation": {
        "type": "query",
        "query": "query getTableStats($tableId: String!) { table(id: $tableId) { id identifier name description nodeCount relationCount createdAt updatedAt } }"
      },
      "examples": [
        {
          "name": "Get user table stats",
          "description": "Get statistics for the users table",
          "input": {
            "tableId": "users-table"
          }
        }
      ]
    },
    {
      "name": "listRelatedNodes",
      "description": "Get all nodes related to a specific node",
      "category": "relationships",
      "complexity": "medium",
      "inputSchema": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "description": "The ID of the central node"
          },
          "relationshipType": {
            "type": "string",
            "description": "Optional filter by relationship type"
          },
          "direction": {
            "type": "string",
            "enum": ["incoming", "outgoing", "both"],
            "description": "Direction of relationships to follow",
            "default": "both"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum number of related nodes to return",
            "minimum": 1,
            "maximum": 50,
            "default": 10
          }
        },
        "required": ["nodeId"],
        "additionalProperties": false
      },
      "graphqlOperation": {
        "type": "query",
        "query": "query listRelatedNodes($nodeId: String!, $relationshipType: String, $direction: String, $limit: Int) { node(id: $nodeId) { id content relatedNodes(relationshipType: $relationshipType, direction: $direction, limit: $limit) { id content relationshipType direction metadata } } }"
      },
      "examples": [
        {
          "name": "Get user's friends",
          "description": "Find all nodes connected with 'friend' relationship",
          "input": {
            "nodeId": "user-123",
            "relationshipType": "friend",
            "direction": "both"
          }
        }
      ]
    },
    {
      "name": "createSimpleNode",
      "description": "Create a new node with basic content",
      "category": "basic-mutations",
      "complexity": "low",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tableId": {
            "type": "string",
            "description": "The table to create the node in"
          },
          "content": {
            "type": "string",
            "description": "Content for the new node",
            "minLength": 1,
            "maxLength": 5000
          },
          "metadata": {
            "type": "object",
            "description": "Optional metadata for the node",
            "additionalProperties": true
          }
        },
        "required": ["tableId", "content"],
        "additionalProperties": false
      },
      "graphqlOperation": {
        "type": "mutation",
        "query": "mutation createSimpleNode($tableId: String!, $content: String!, $metadata: JSON) { createNode(tableId: $tableId, content: $content, metadata: $metadata) { success node { id content metadata createdAt } errors { message } } }"
      },
      "examples": [
        {
          "name": "Create user profile",
          "description": "Create a new user profile node",
          "input": {
            "tableId": "users-table",
            "content": "John Doe - Software Engineer",
            "metadata": {
              "email": "john@example.com",
              "department": "Engineering"
            }
          }
        }
      ]
    },
    {
      "name": "connectNodes",
      "description": "Create a relationship between two existing nodes",
      "category": "relationships",
      "complexity": "low",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fromNodeId": {
            "type": "string",
            "description": "ID of the source node"
          },
          "toNodeId": {
            "type": "string",
            "description": "ID of the target node"
          },
          "relationshipType": {
            "type": "string",
            "description": "Type of relationship (e.g., 'friend', 'follows', 'works_with')",
            "minLength": 1
          },
          "properties": {
            "type": "object",
            "description": "Optional properties for the relationship",
            "additionalProperties": true
          }
        },
        "required": ["fromNodeId", "toNodeId", "relationshipType"],
        "additionalProperties": false
      },
      "graphqlOperation": {
        "type": "mutation",
        "query": "mutation connectNodes($fromNodeId: String!, $toNodeId: String!, $relationshipType: String!, $properties: JSON) { createRelation(fromNodeId: $fromNodeId, toNodeId: $toNodeId, relationshipType: $relationshipType, properties: $properties) { success relation { id fromNodeId toNodeId relationshipType properties } errors { message } } }"
      },
      "examples": [
        {
          "name": "Connect friends",
          "description": "Create a friendship relationship",
          "input": {
            "fromNodeId": "user-123",
            "toNodeId": "user-456",
            "relationshipType": "friend",
            "properties": {
              "since": "2025-01-01",
              "strength": "close"
            }
          }
        }
      ]
    },
    {
      "name": "getRecentNodes",
      "description": "Get recently created or updated nodes",
      "category": "utilities",
      "complexity": "low",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tableId": {
            "type": "string",
            "description": "Optional table ID to filter by"
          },
          "orderBy": {
            "type": "string",
            "enum": ["created", "updated"],
            "description": "Sort by creation or update time",
            "default": "created"
          },
          "limit": {
            "type": "integer",
            "description": "Number of nodes to return",
            "minimum": 1,
            "maximum": 50,
            "default": 10
          }
        },
        "additionalProperties": false
      },
      "graphqlOperation": {
        "type": "query",
        "query": "query getRecentNodes($tableId: String, $orderBy: String, $limit: Int) { recentNodes(tableId: $tableId, orderBy: $orderBy, limit: $limit) { nodes { id content metadata createdAt updatedAt table { identifier name } } totalCount } }"
      },
      "examples": [
        {
          "name": "Get latest updates",
          "description": "Get the 5 most recently updated nodes",
          "input": {
            "orderBy": "updated",
            "limit": 5
          }
        }
      ]
    }
  ],
  "categories": {
    "basic-queries": {
      "description": "Simple data retrieval operations",
      "icon": "🔍",
      "tools": ["getNodeById", "findNodesByContent", "getRecentNodes"]
    },
    "basic-mutations": {
      "description": "Create, update, and delete operations",
      "icon": "✏️",
      "tools": ["createSimpleNode", "updateNode", "deleteNode"]
    },
    "relationships": {
      "description": "Operations for managing node relationships",
      "icon": "🔗",
      "tools": ["connectNodes", "listRelatedNodes"]
    },
    "utilities": {
      "description": "Helpful utility functions",
      "icon": "🛠️",
      "tools": ["getTableStats", "getRecentNodes"]
    }
  },
  "complexity": {
    "low": {
      "description": "Simple operations that most users will need",
      "executionTime": "< 100ms",
      "resourceUsage": "minimal"
    },
    "medium": {
      "description": "Moderate complexity with some configuration",
      "executionTime": "100ms - 1s",
      "resourceUsage": "moderate"
    }
  },
  "commonUseCases": [
    {
      "name": "User Management",
      "description": "Managing user profiles and connections",
      "tools": ["createSimpleNode", "getNodeById", "updateNode", "connectNodes"],
      "workflow": [
        "1. Create user with createSimpleNode",
        "2. Update profile with updateNode",
        "3. Connect friends with connectNodes",
        "4. Find friends with listRelatedNodes"
      ]
    },
    {
      "name": "Content Discovery",
      "description": "Finding and browsing content",
      "tools": ["findNodesByContent", "getRecentNodes", "listRelatedNodes"],
      "workflow": [
        "1. Search content with findNodesByContent",
        "2. Browse recent items with getRecentNodes",
        "3. Explore related content with listRelatedNodes"
      ]
    },
    {
      "name": "Data Maintenance",
      "description": "Keeping data clean and organized",
      "tools": ["getTableStats", "updateNode", "deleteNode"],
      "workflow": [
        "1. Check table health with getTableStats",
        "2. Update outdated content with updateNode",
        "3. Remove unnecessary nodes with deleteNode"
      ]
    }
  ]
}