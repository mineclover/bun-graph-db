{
  "name": "analyzeProjectHealth",
  "description": "프로젝트 건강도 종합 분석 - 테이블 구조, 노드 분포, 관계 밀도, 성능 지표를 통합 분석",
  "inputSchema": {
    "type": "object",
    "properties": {
      "scope": {
        "type": "string",
        "enum": ["all", "table", "node", "relation"],
        "description": "분석 범위 (전체/테이블/노드/관계)",
        "default": "all"
      },
      "tableId": {
        "type": "string",
        "description": "특정 테이블 분석 시 테이블 ID (scope가 'table'일 때 필수)"
      },
      "metrics": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["performance", "integrity", "growth", "usage"]
        },
        "description": "포함할 메트릭 유형들",
        "default": ["performance", "integrity"]
      },
      "timeRange": {
        "type": "string",
        "enum": ["1h", "24h", "7d", "30d"],
        "description": "분석 기간",
        "default": "24h"
      },
      "includeRecommendations": {
        "type": "boolean",
        "description": "개선 권장사항 포함 여부",
        "default": true
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "graphqlOperation": {
    "operationType": "custom",
    "query": "project_health_analysis"
  }
}