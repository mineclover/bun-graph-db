{
  "name": "searchNodesByContent",
  "description": "내용 기반 노드 검색 - 텍스트 유사도와 의미적 검색을 지원하는 고급 검색 도구",
  "inputSchema": {
    "type": "object",
    "properties": {
      "searchTerm": {
        "type": "string",
        "description": "검색할 텍스트 내용"
      },
      "tableId": {
        "type": "string",
        "description": "검색 대상 테이블 ID (선택사항)"
      },
      "searchMode": {
        "type": "string",
        "enum": ["exact", "fuzzy", "semantic"],
        "description": "검색 모드",
        "default": "fuzzy"
      },
      "limit": {
        "type": "integer",
        "description": "최대 결과 수",
        "default": 10,
        "minimum": 1,
        "maximum": 100
      },
      "includeAttributes": {
        "type": "boolean",
        "description": "노드 속성 포함 여부",
        "default": false
      },
      "sortBy": {
        "type": "string",
        "enum": ["relevance", "createdAt", "updatedAt"],
        "description": "정렬 기준",
        "default": "relevance"
      }
    },
    "required": ["searchTerm"],
    "additionalProperties": false
  },
  "graphqlOperation": {
    "operationType": "query",
    "query": "query searchNodesByContent($searchTerm: String!, $tableId: String, $limit: Int) { searchNodes(tableId: $tableId, searchTerm: $searchTerm, limit: $limit) { success nodes { id content createdAt updatedAt } totalCount errors { message code } } }"
  }
}