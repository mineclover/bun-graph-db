{
	"name": "bun-graph-db",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.3.9",
	"engines": {
		"bun": "1.3.9"
	},
	"scripts": {
		"start": "bun index.ts",
		"dev": "bun --watch index.ts --",
		"build": "bun build index.ts --outdir ./dist --target bun",
		"test": "bun run scripts/test-lanes.ts",
		"test:direct": "bun test",
		"test:lanes:audit": "bun run scripts/test-lanes.ts --audit",
		"test:parallel-safe": "bun run scripts/test-lanes.ts --lane parallel-safe",
		"test:serial": "bun run scripts/test-lanes.ts",
		"test:serial-only": "bun run scripts/test-lanes.ts --lane serial-only",
		"test:bun": "bun test --coverage",
		"test:templates": "bun tests/test-runner.ts",
		"test:isolated": "bun tests/test-runner.ts",
		"test:unit": "bun tests/test-runner.ts unit",
		"test:unit:parallel": "bun tests/test-runner.ts unit --parallel",
		"test:integration": "bun tests/test-runner.ts integration",
		"test:e2e": "bun run scripts/test-lanes.ts --lane e2e",
		"test:stress": "bun run scripts/test-lanes.ts --lane stress",
		"test:all:isolated": "bun tests/test-runner.ts --parallel",
		"template:check-server": "curl -s http://localhost:4000/graphql -d '{\"query\":\"query{__typename}\"}' || echo 'Server not running'",
		"export:fixed": "bun scripts/export-all-templates-fixed.ts",
		"projection:export": "bun run scripts/export-oa-sdk-projection-artifacts.ts",
		"projection:check": "bun test tests/contract/oa-sdk-projection-artifacts.test.ts",
		"benchmark:hotpaths": "bun run scripts/benchmark-hotpaths.ts",
		"benchmark:hotpaths:ci": "bun run scripts/benchmark-hotpaths.ts --profile ci",
		"benchmark:vector-storage": "bun run scripts/benchmark-vector-storage.ts",
		"typecheck:benchmark": "tsc --project scripts/tsconfig.benchmark.json --noEmit",
		"ci:versions": "bun run scripts/ci-versions.ts",
		"lint": "biome lint .",
		"check:biome": "biome lint index.ts src tests/unit/schema && biome lint --error-on-warnings scripts/ci-versions.ts scripts/check-docs.ts tests/unit/check-docs.test.ts tests/unit/breadth-first-search.test.ts tests/unit/strongly-connected-components.test.ts tests/unit/page-rank.test.ts tests/unit/exact-vector-index.test.ts tests/unit/node-field-resolvers-graph-traversal.test.ts scripts/check-codegen.ts scripts/test-lanes.ts scripts/export-oa-sdk-projection-artifacts.ts scripts/benchmark-hotpaths.ts scripts/benchmark-vector-storage.ts scripts/fixtures/oa-sdk-projection-fixture.ts tests/unit/benchmark-hotpaths.test.ts tests/unit/test-lanes-script.test.ts tests/contract/oa-sdk-projection-artifacts.test.ts package.json tsconfig.contract.json scripts/tsconfig.benchmark.json",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "bun run check:static",
		"check:write": "biome check --write .",
		"check:docs": "bun run scripts/check-docs.ts",
		"check:static": "bun run check:docs && bun run ci:versions && bun run check:biome && bun run typecheck && bun run typecheck:contract && bun run typecheck:benchmark && bun run check:codegen && bun run build",
		"typecheck": "tsc --noEmit",
		"typecheck:contract": "tsc --project tsconfig.contract.json --noEmit",
		"codegen": "graphql-codegen",
		"check:codegen": "bun run scripts/check-codegen.ts"
	},
	"devDependencies": {
		"@oa-sdk/openapi-projection-contract": "file:../../packages/openapi-projection-contract",
		"@biomejs/biome": "2.5.7",
		"@graphql-codegen/cli": "^7.2.0",
		"@graphql-codegen/introspection": "^6.1.0",
		"@graphql-codegen/typescript": "^6.1.0",
		"@graphql-codegen/typescript-operations": "^6.1.5",
		"@types/bun": "1.3.14",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/json-schema": "^7.0.15",
		"@types/node": "^26.2.0",
		"jest": "^30.4.2",
		"rimraf": "^6.1.3",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"@graphql-tools/load-files": "^7.0.1",
		"@graphql-tools/merge": "^9.2.2",
		"@graphql-tools/schema": "^10.0.38",
		"@graphql-tools/utils": "^11.2.2",
		"@modelcontextprotocol/server": "^2.0.0",
		"ajv": "^8.20.0",
		"graphql": "16.14.2",
		"graphql-request": "^7.4.0",
		"graphql-scalars": "^1.25.0",
		"graphql-yoga": "^5.21.2",
		"ws": "^8.21.3",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	}
}
