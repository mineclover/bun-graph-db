{
  "name": "bun-graph-db",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch index.ts",
    "start": "bun index.ts",
    "build": "bun build index.ts --outdir ./dist --target bun",
    "test": "bun test/unified-test-runner.ts all",
    "test:list:old": "bun test/unified-test-runner.ts list",
    "test:bun": "bun test --coverage",
    "test:integration:old": "bun test/test-runner.ts full",
    "test:specific": "bun test/unified-test-runner.ts run",
    "test:coverage": "bun test/unified-test-runner.ts coverage",
    "test:fix-types": "bun test/framework/scripts/fix-test-types.ts",
    "test:validate": "bun test/framework/scripts/fix-test-types.ts --validate",
    "test:setup": "bun test/runner/simple-test-runner.ts setup",
    "test:queries": "bun test/runner/simple-test-runner.ts queries",
    "test:all": "bun test/runner/simple-test-runner.ts all",
    "test:query-validator": "bun test/query-validator.ts validate",
    "test:query-analytics": "bun test/query-validator.ts analytics",
    "query:report": "bun scripts/query-manager.ts report",
    "query:validate": "bun scripts/query-manager.ts validate",
    "demo": "bun demo/run-demo.ts",
    "demo:basic": "bun demo/template-queries/basic-demo.ts",
    "demo:import-export": "bun demo/run-import-export-demo.ts",
    "demo:file-import-export": "bun demo/run-file-import-export-demo.ts",
    "demo:cleanup-files": "bun demo/run-file-import-export-demo.ts --cleanup",
    "demo:test-dataset": "bun demo/curl-tester.ts",
    "export:all-templates": "bun scripts/export-all-templates.ts",
    "cleanup:templates": "bun scripts/cleanup-templates.ts",
    "cleanup:templates-dry-run": "bun scripts/cleanup-templates.ts dry-run",
    "cleanup:templates-auto": "bun scripts/cleanup-templates.ts auto",
    "demo:test-batch": "bun demo/curl-tester.ts --batch",
    "demo:test-all": "bun demo/curl-tester.ts --all",
    "demo:template-generation": "bun scripts/generate-template-demo.ts",
    "query:plan": "bun scripts/query-manager.ts plan",
    "query:test": "bun scripts/test-queries.ts",
    "query:minimal": "bun scripts/test-queries.ts minimal",
    "query:detailed": "bun scripts/test-queries.ts detailed",
    "dataset:generate": "bun datasets/scripts/generate-sample-data.ts",
    "dataset:import": "bun datasets/scripts/import-templates-to-server.ts",
    "template:list": "bun datasets/scripts/template-manager.ts list",
    "template:search": "bun datasets/scripts/template-manager.ts search",
    "template:validate": "bun datasets/scripts/template-manager.ts validate",
    "logs:view": "bun test/setup/utilities/view-logs.ts",
    "logs:stats": "bun test/setup/utilities/view-logs.ts stats",
    "logs:failed": "bun test/setup/utilities/view-logs.ts failed",
    "logs:report": "bun test/setup/utilities/view-logs.ts report",
    "logs:clear": "bun test/setup/utilities/view-logs.ts clear",
    "test:run": "bun test/runner/entry-points/test-runner.ts",
    "test:list": "bun test/runner/entry-points/test-runner.ts list",
    "test:stats": "bun test/runner/entry-points/test-runner.ts stats",
    "test:log-stats": "bun test/runner/entry-points/test-runner.ts log-stats",
    "test:clear-logs": "bun test/runner/entry-points/test-runner.ts clear-logs",
    "test:template": "bun test/runner/entry-points/test-runner.ts category template",
    "test:crud:old": "bun test/runner/entry-points/test-runner.ts run template-crud",
    "test:all:old": "bun test/runner/entry-points/test-runner.ts all",
    "test:clean": "bun test/runner/entry-points/test-runner.ts clear-logs && bun test/runner/entry-points/test-runner.ts all",
    "template:complexity": "bun datasets/scripts/template-manager.ts complexity",
    "template:import": "bun datasets/scripts/template-manager.ts import",
    "test:api": "bun test/api/api-test-runner.ts",
    "test:api:queries": "bun test/api/api-test-runner.ts --category queries",
    "test:api:mutations": "bun test/api/api-test-runner.ts --category mutations",
    "test:api:scenarios": "bun test/api/api-test-runner.ts --category scenarios",
    "test:api:dev": "bun test/api/api-test-runner.ts --env development",
    "test:api:staging": "bun test/api/api-test-runner.ts --env staging",
    "test:api:prod": "bun test/api/api-test-runner.ts --env production",
    "test:templates": "bun tests/test-runner.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "schema:generate": "bun scripts/generate-schema.ts",
    "codegen": "graphql-codegen",
    "schema:update": "bun schema:generate && bun codegen",
    "template:validate-single": "bun scripts/simple-validator.ts",
    "template:check-server": "curl -s http://localhost:4000/graphql -d '{\"query\":\"query{__typename}\"}' || echo 'Server not running'",
    "template:backup": "cp -r demo/templates demo/templates-backup-$(date +%Y%m%d-%H%M%S)",
    "template:restore": "echo 'Usage: cp -r demo/templates-backup-YYYYMMDD-HHMMSS demo/templates'"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/introspection": "^4.0.3",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@types/bun": "latest",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "jest": "^30.1.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@graphql-tools/load-files": "^7.0.1",
    "@graphql-tools/merge": "^9.1.1",
    "@graphql-tools/schema": "^10.0.25",
    "@graphql-tools/utils": "^10.9.1",
    "@tanstack/react-query": "^5.87.1",
    "@tanstack/react-query-devtools": "^5.87.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "graphql": "^16.11.0",
    "graphql-request": "^7.1.2",
    "graphql-scalars": "^1.24.2",
    "graphql-yoga": "^5.15.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.18.3",
    "yaml": "^2.8.1"
  }
}
