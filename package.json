{
  "name": "bun-graph-db",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun index.ts",
    "dev": "bun --watch index.ts --",
    "build": "bun build index.ts --outdir ./dist --target bun",
    "test": "bun test",
    "test:bun": "bun test --coverage",
    "test:templates": "bun tests/test-runner.ts",
    "test:isolated": "bun tests/test-runner.ts",
    "test:unit": "bun tests/test-runner.ts unit",
    "test:unit:parallel": "bun tests/test-runner.ts unit --parallel",
    "test:integration": "bun tests/test-runner.ts integration",
    "test:e2e": "bun tests/test-runner.ts e2e",
    "test:legacy": "bun tests/test-runner.ts template-indexing",
    "test:all:isolated": "bun tests/test-runner.ts --parallel",
    "dataset:generate": "bun datasets/scripts/generate-sample-data.ts",
    "dataset:import": "bun datasets/scripts/import-templates-to-server.ts",
    "template:list": "bun datasets/scripts/template-manager.ts list",
    "template:search": "bun datasets/scripts/template-manager.ts search",
    "template:validate": "bun datasets/scripts/template-manager.ts validate",
    "template:complexity": "bun datasets/scripts/template-manager.ts complexity",
    "template:import": "bun datasets/scripts/template-manager.ts import",
    "template:check-server": "curl -s http://localhost:4000/graphql -d '{\"query\":\"query{__typename}\"}' || echo 'Server not running'",
    "export:fixed": "bun scripts/export-all-templates-fixed.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/introspection": "^4.0.3",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@types/bun": "latest",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^24.3.0",
    "@types/uuid": "^10.0.0",
    "jest": "^30.1.3",
    "rimraf": "^6.0.1",
    "uuid": "^10.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@graphql-tools/load-files": "^7.0.1",
    "@graphql-tools/merge": "^9.1.1",
    "@graphql-tools/schema": "^10.0.25",
    "@graphql-tools/utils": "^10.9.1",
    "@modelcontextprotocol/sdk": "^1.18.1",
    "@tanstack/react-query": "^5.87.1",
    "@tanstack/react-query-devtools": "^5.87.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "ajv": "^8.17.1",
    "graphql": "^16.11.0",
    "graphql-request": "^7.1.2",
    "graphql-scalars": "^1.24.2",
    "graphql-yoga": "^5.15.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.18.3",
    "yaml": "^2.8.1"
  }
}
